# Copy to .env and replace the placeholders with your Neon connection details.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
ALLOW_DEMO_SEED=false
FRONTEND_URL=http://localhost:3000

# Optional in development. Configure these for production invitation email.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Workline <no-reply@example.com>
